<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Lets IRIS see and open other installed apps by name. Without this, Android 11+ hides
         most apps from queryIntentActivities() by default (a privacy feature called "package
         visibility") — only system apps like Camera stay visible, which is exactly why open_app
         worked for Camera but reported WhatsApp/Chrome/TikTok as "not installed" even when they
         were. Fine to declare broadly here since this is a personal sideloaded app, not something
         going through Play Store review. -->
    <uses-permission android:name="android.permission.QUERY_ALL_PACKAGES"
        tools:ignore="QueryAllPackagesPermission" />

    <!-- Voice -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Foreground assistant service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MICROPHONE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Phone control -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.CALL_PHONE" />
    <uses-permission android:name="android.permission.ANSWER_PHONE_CALLS" />

    <!-- Toggles -->
    <uses-permission android:name="android.permission.BLUETOOTH" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <uses-permission android:name="android.permission.WRITE_SETTINGS" tools:ignore="ProtectedPermissions" />
    <uses-permission android:name="android.permission.CAMERA" /> <!-- flashlight torch -->

    <!-- Notifications read/reply -->
    <uses-permission android:name="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE"
        tools:ignore="ProtectedPermissions" />

    <!-- Screenshot capture -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />

    <!-- Reminders -->
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />

    <!-- Lets IRIS ask to be exempted from battery optimization, which is the main reason
         background wake-word listening dies when the app isn't in the foreground -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Contacts (resolve a name to a phone number for calls/WhatsApp) -->
    <uses-permission android:name="android.permission.READ_CONTACTS" />

    <!-- Storage (scoped) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />

    <application
        android:name=".IrisApplication"
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="IRIS"
        android:theme="@style/Theme.Iris"
        android:usesCleartextTraffic="false">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:theme="@style/Theme.Iris">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Keeps the agent + mic loop alive while listening -->
        <service
            android:name=".services.IrisForegroundService"
            android:exported="false"
            android:foregroundServiceType="microphone" />

        <!-- Reads and replies to notifications (WhatsApp, SMS, etc.) -->
        <service
            android:name=".services.IrisNotificationListenerService"
            android:exported="false"
            android:permission="android.permission.BIND_NOTIFICATION_LISTENER_SERVICE">
            <intent-filter>
                <action android:name="android.service.notification.NotificationListenerService" />
            </intent-filter>
        </service>

        <!-- Optional, opt-in: taps UI elements for actions Android has no API for
             (WhatsApp auto-send, call auto-answer). Off by default. -->
        <service
            android:name=".services.IrisAccessibilityService"
            android:exported="false"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>

        <!-- Lets IRIS reject spam/unwanted calls via the supported CallScreeningService API -->
        <service
            android:name=".services.IrisCallScreeningService"
            android:exported="true"
            android:permission="android.permission.BIND_SCREENING_SERVICE">
            <intent-filter>
                <action android:name="android.telecom.CallScreeningService" />
            </intent-filter>
        </service>

        <!-- One-shot screen capture, started on demand by the take_screenshot tool -->
        <service
            android:name=".services.ScreenshotService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />

        <receiver
            android:name=".tools.ReminderReceiver"
            android:exported="false" />

    </application>
</manifest>
